<?xml version="1.0" encoding="utf-8"?>
<!--
  Production traffic must be HTTPS. Plain http:// is permitted only for the
  loopback addresses used during development (10.0.2.2 is the host machine as
  seen from the Android emulator), so a release build can never silently fall
  back to an unencrypted connection to a real server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
