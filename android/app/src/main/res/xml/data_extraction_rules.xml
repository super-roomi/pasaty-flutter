<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ splits what `allowBackup` used to cover into two channels.
  `allowBackup="false"` stops cloud backup, but device-to-device transfer is
  governed here and is NOT covered by it — without these rules a new-phone
  transfer would still carry the encrypted credential store across, where the
  KeyStore key that decrypts it cannot follow.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
