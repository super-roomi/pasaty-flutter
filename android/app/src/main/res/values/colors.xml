<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Adaptive launcher icon background. Generated by flutter_launcher_icons
         from pubspec.yaml (adaptive_icon_background) — keep the two in step. -->
    <color name="ic_launcher_background">#FFFFFF</color>

    <!-- Splash background. Matches AppColors.background so the hand-off to the
         first Flutter frame is invisible rather than a white flash. -->
    <color name="launch_background">#FBF9FB</color>

    <!-- Tint Android applies behind the (white-masked) notification icon.
         AppColors.deepNavy, so the tray entry reads as this app. -->
    <color name="notification_accent">#1A2B48</color>
</resources>
