# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Golden-test failure artifacts. Written by `flutter test` on a mismatch and
# regenerated every run; the masters under test/goldens/ are the tracked ones.
/test/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing — the upload keystore and its passwords must never be
# committed. Losing the keystore means the Play listing can never be updated,
# so keep an offline backup outside the repo.
/android/key.properties
*.jks
*.keystore

# Build-time config: backend URL + Mapbox public token. Not committed —
# the token is billable to the account and should stay URL-restricted.
dart_defines.json
